<UserControl x:Class="MusicTagRecover.Views.TagEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MusicTagRecover.ViewModels"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="WrenchButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Content" Value="🔧"/>
            <Setter Property="ToolTip" Value="编码修正"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1,0,0,0" Width="330" MinWidth="300">
        <DockPanel>
            <!-- 顶部标题与保存 -->
            <Grid DockPanel.Dock="Top" Margin="12,12,12,8">
                <TextBlock Text="标签编辑" FontSize="{StaticResource FontSizeTitle}" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="保存修改" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right" Width="92"
                        Click="OnSaveClicked"/>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12,0,12,12">

                    <!-- 11 个文本字段（ItemsControl 模板，必须是 DataTemplate） -->
                    <ItemsControl ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TagFieldVm}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="●" Foreground="{StaticResource DangerBrush}"
                                                   FontSize="8" Margin="3,0,0,0"
                                                   Visibility="{Binding IsModified, Converter={x:Static vm:TagEditConverters.ModifiedVisibility}}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Margin="0,0,6,0"
                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="2" Style="{StaticResource WrenchButton}"
                                            Command="{Binding DataContext.RequestEncodingFixCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 歌词 -->
                    <Grid Margin="0,10,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="歌词" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="●" Foreground="{StaticResource DangerBrush}"
                                       FontSize="8" Margin="3,0,0,0"
                                       Visibility="{Binding LyricsModified, Converter={x:Static vm:TagEditConverters.ModifiedVisibility}}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="编码" Style="{StaticResource ToolButton}"
                                    Padding="8,3" Margin="2,0"
                                    Command="{Binding FixLyricsEncodingCommand}"/>
                            <Button Content="编辑…" Style="{StaticResource ToolButton}"
                                    Padding="8,3" Margin="2,0"
                                    Command="{Binding EditLyricsCommand}"/>
                        </StackPanel>
                    </Grid>
                    <TextBox Style="{StaticResource MultilineTextBox}" MinHeight="84" MaxHeight="160"
                             Text="{Binding LyricsText, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"/>

                    <!-- 封面区 -->
                    <Border Margin="0,14,0,0" Padding="10" Background="White"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="封面" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="◀" Width="30" Height="28" Padding="0" Margin="0"
                                            Style="{StaticResource ToolButton}"
                                            ToolTip="上一张封面"
                                            Command="{Binding PrevPictureCommand}"/>
                                    <TextBlock Width="52" TextAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Text="{Binding PictureIndexText}"/>
                                    <Button Content="▶" Width="30" Height="28" Padding="0" Margin="0"
                                            Style="{StaticResource ToolButton}"
                                            ToolTip="下一张封面"
                                            Command="{Binding NextPictureCommand}"/>
                                </StackPanel>
                            </Grid>
                            <!-- 封面图（右键菜单操作） -->
                            <Border Width="190" Height="190" Margin="0,10" HorizontalAlignment="Center"
                                    Background="{StaticResource RowHoverBrush}" CornerRadius="4">
                                <Grid>
                                    <Image Source="{Binding CoverImage}" Stretch="Uniform" Margin="4"/>
                                    <TextBlock Text="无封面" Foreground="{StaticResource TextDisabledBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasCover, Converter={x:Static vm:TagEditConverters.NoCoverVisibility}}"/>
                                </Grid>
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="添加封面（本地图片）…"
                                                  Command="{Binding RequestAddFromDiskCommand}"/>
                                        <MenuItem Header="在线搜索封面…"
                                                  Command="{Binding RequestOnlineSearchCommand}"/>
                                        <MenuItem Header="更改分辨率…"
                                                  Command="{Binding RequestCompressCommand}"
                                                  IsEnabled="{Binding HasCover}"/>
                                        <MenuItem Header="删除当前封面"
                                                  Command="{Binding DeleteCurrentPictureCommand}"
                                                  IsEnabled="{Binding HasCover}"/>
                                        <Separator/>
                                        <MenuItem Header="打开图片"
                                                  Command="{Binding RequestOpenExternalCommand}"
                                                  IsEnabled="{Binding HasCover}"/>
                                        <MenuItem Header="提取图片…"
                                                  Command="{Binding RequestExtractCommand}"
                                                  IsEnabled="{Binding HasCover}"/>
                                        <Separator/>
                                        <MenuItem Header="封面类型" IsEnabled="{Binding HasCover}">
                                            <MenuItem x:Name="PictureTypeMenu" Header="（加载中…）"/>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>
                            </Border>

                            <!-- 封面信息 -->
                            <StackPanel Margin="2,8,2,0" HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding CoverInfo.Format, StringFormat='格式：{0}'}"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding CoverInfo.Resolution, StringFormat='分辨率：{0}'}"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding CoverInfo.Size, StringFormat='大小：{0}'}"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding CoverInfo.Type, StringFormat='类型：{0}'}"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <CheckBox Content="覆盖已有封面" Margin="2,10,2,2"
                                      IsChecked="{Binding OverwriteExisting}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
