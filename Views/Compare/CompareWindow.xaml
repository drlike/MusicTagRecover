<Window x:Class="MusicTagRecover.Views.Compare.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inf="clr-namespace:MusicTagRecover.Infrastructure"
        Title="文件比对"
        Width="1000" Height="650" MinWidth="860" MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBgBrush}">

    <Window.Resources>
        <!-- 枚举 ↔ RadioButton 互转；文件大小格式化（全局未注册为 StaticResource，窗口内按需实例化） -->
        <inf:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <inf:FileSizeConverter x:Key="FileSizeConverter"/>
        <inf:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- ============ 底部操作按钮 ============ -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="3" Padding="10,8" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="删除源文件" Style="{StaticResource DangerButton}"
                        Click="DeleteSources_Click"/>
                <Button Content="查找空目录" Style="{StaticResource BaseButton}"
                        Margin="8,0,0,0" Command="{Binding FindEmptyDirsCommand}"/>
                <Button Content="删除历史" Style="{StaticResource BaseButton}"
                        Margin="8,0,0,0" Click="OpenDeleteHistory_Click"/>
            </StackPanel>
        </Border>

        <!-- ============ 状态栏 ============ -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BottomBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="3" Padding="10,6" Margin="0,8,0,0">
            <WrapPanel>
                <TextBlock Text="{Binding SourceFileCount, StringFormat='源文件数：{0}'}" Margin="0,2,8,2"/>
                <TextBlock Text="｜" Margin="0,2,8,2" Foreground="{StaticResource BorderBrush}"/>
                <TextBlock Text="{Binding TargetFileCount, StringFormat='目标文件数：{0}'}" Margin="0,2,8,2"/>
                <TextBlock Text="｜" Margin="0,2,8,2" Foreground="{StaticResource BorderBrush}"/>
                <TextBlock Text="{Binding Results.Count, StringFormat='命中数：{0}'}" Margin="0,2,8,2"/>
                <TextBlock Text="｜" Margin="0,2,8,2" Foreground="{StaticResource BorderBrush}"/>
                <TextBlock Text="{Binding CacheHits, StringFormat='缓存命中数：{0}'}" Margin="0,2,8,2"
                           ToolTip="缓存命中计数取决于扫描服务回传（当前服务版本未累加该值，恒为 0）"/>
                <TextBlock Text="｜" Margin="0,2,8,2" Foreground="{StaticResource BorderBrush}"/>
                <TextBlock Text="{Binding ExcludedCount, StringFormat='被排重目录数：{0}'}" Margin="0,2,8,2"
                           ToolTip="{Binding ExcludedText}"/>
            </WrapPanel>
        </Border>

        <!-- ============ 空目录临时面板 ============ -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                CornerRadius="3" Padding="10,8" Margin="0,8,0,0"
                Visibility="{Binding ShowEmptyPanel, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="{Binding EmptyPanelTitle}" FontWeight="Bold"/>
                    <Button Content="删除选中空目录" Style="{StaticResource DangerButton}"
                            Margin="12,0,0,0" Click="DeleteEmptyDirs_Click"/>
                    <Button Content="关闭面板" Style="{StaticResource BaseButton}"
                            Margin="8,0,0,0" Command="{Binding CloseEmptyPanelCommand}"/>
                </StackPanel>
                <ListBox x:Name="EmptyDirsList" ItemsSource="{Binding EmptyDirs}"
                         SelectionMode="Extended" Height="120"/>
            </DockPanel>
        </Border>

        <!-- ============ 顶部设置区 ============ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="3" Padding="12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 源目录 -->
                    <StackPanel Grid.Column="0">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="源目录（待删除方）" FontWeight="Bold"
                                       Foreground="{StaticResource WarningBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="添加目录" Style="{StaticResource ToolButton}"
                                        Command="{Binding AddSourceDirCommand}"/>
                                <Button Content="移除选中" Style="{StaticResource ToolButton}"
                                        Command="{Binding RemoveSourceDirCommand}"/>
                                <Button Content="清空" Style="{StaticResource ToolButton}"
                                        Command="{Binding ClearSourceDirsCommand}"/>
                            </StackPanel>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding SourceDirs}"
                                 SelectedItem="{Binding SelectedSourceDir}"
                                 Height="110"/>
                    </StackPanel>

                    <!-- 目标目录 -->
                    <StackPanel Grid.Column="2">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="目标目录（保留方）" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="添加目录" Style="{StaticResource ToolButton}"
                                        Command="{Binding AddTargetDirCommand}"/>
                                <Button Content="移除选中" Style="{StaticResource ToolButton}"
                                        Command="{Binding RemoveTargetDirCommand}"/>
                                <Button Content="清空" Style="{StaticResource ToolButton}"
                                        Command="{Binding ClearTargetDirsCommand}"/>
                            </StackPanel>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding TargetDirs}"
                                 SelectedItem="{Binding SelectedTargetDir}"
                                 Height="110"/>
                    </StackPanel>
                </Grid>

                <!-- 匹配规则（窄窗口自动换行） -->
                <WrapPanel Margin="0,12,0,0">
                    <TextBlock Text="匹配规则：" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <RadioButton Content="基础属性（文件名+大小）" VerticalAlignment="Center"
                                 IsChecked="{Binding SelectedRule, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=NameAndSize}"/>
                    <RadioButton Content="MD5 哈希" VerticalAlignment="Center"
                                 IsChecked="{Binding SelectedRule, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Md5}"/>
                    <RadioButton Content="音视频标签（标题+艺术家）" VerticalAlignment="Center"
                                 IsChecked="{Binding SelectedRule, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=MediaTag}"/>
                </WrapPanel>

                <!-- 开始 / 取消 -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="开始比对" Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding IsNotScanning}"
                            Command="{Binding StartScanCommand}"/>
                    <Button Content="取消" Style="{StaticResource BaseButton}"
                            Margin="8,0,0,0"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"
                            Command="{Binding CancelScanCommand}"/>
                </StackPanel>

                <!-- 进度 -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressBar Width="320"
                                 Maximum="{Binding ProgressMaximum}"
                                 Value="{Binding ProgressValue}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"/>
                    <TextBlock Text="{Binding ProgressText}" Margin="10,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============ 结果区 ============ -->
        <Border Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="3" Padding="10" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="比对结果（源=待删除方，目标=保留方；双击行可在资源管理器中定位源文件）"
                           Margin="2,0,0,8" Foreground="{StaticResource TextSecondaryBrush}"/>
                <!-- DataGrid 样式、虚拟化、多选等默认值均由 Theme.xaml 提供，这里不重设 -->
                <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}"
                          MouseDoubleClick="ResultsGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="源文件名（待删除）" Binding="{Binding SourceName}" Width="140"/>
                        <DataGridTextColumn Header="源目录" Binding="{Binding SourceDir}" Width="140"/>
                        <DataGridTextColumn Header="源大小" Width="68"
                                            Binding="{Binding SourceSize, Converter={StaticResource FileSizeConverter}}"/>
                        <DataGridTextColumn Header="目标文件名（保留）" Binding="{Binding TargetName}" Width="140"/>
                        <DataGridTextColumn Header="目标目录" Binding="{Binding TargetDir}" Width="*" MinWidth="110"/>
                        <DataGridTextColumn Header="目标大小" Width="68"
                                            Binding="{Binding TargetSize, Converter={StaticResource FileSizeConverter}}"/>
                        <DataGridTextColumn Header="匹配规则" Binding="{Binding RuleName}" Width="100"/>
                        <DataGridTextColumn Header="源修改时间" Width="132"
                                            Binding="{Binding LastModified, StringFormat='yyyy-MM-dd HH:mm:ss'}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
