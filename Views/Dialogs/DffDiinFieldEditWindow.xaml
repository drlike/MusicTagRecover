<Window x:Class="MusicTagRecover.Views.Dialogs.DffDiinFieldEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑 DIIN 原生字段"
        Width="480" SizeToContent="Height"
        MinWidth="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PageBgBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,0,0,10"
                   Text="DIIN 是 DSDIFF 容器的原生标签块，字段 ID 为 4 字符的子 chunk（如 DITI 标题、DIAR 艺术家）。内容以 UTF-8 编码写入。"/>

        <TextBlock Text="字段 ID" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ComboBox x:Name="IdBox" MinHeight="30" IsEditable="True"
                  SelectionChanged="OnIdSelectionChanged"/>
        <TextBlock x:Name="IdHint" FontSize="12" Margin="0,3,0,0"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="可从列表选择或直接输入 4 字符自定义 ID（仅限可打印 ASCII）。"/>

        <TextBlock Text="字段内容" FontWeight="SemiBold" Margin="0,10,0,4"/>
        <TextBox x:Name="TextBox" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>

        <TextBlock x:Name="ErrorText" Foreground="#C0392B" TextWrapping="Wrap"
                   Margin="0,8,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Click="OnOk" Margin="0,0,8,0"/>
            <Button Content="取消" Style="{StaticResource BaseButton}" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
