<Window x:Class="MusicTagRecover.Views.Dialogs.TagSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inf="clr-namespace:MusicTagRecover.Infrastructure"
        Title="搜索标签"
        Width="900" Height="600"
        MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PageBgBrush}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <inf:BoolToVisibilityConverter x:Key="BusyVis"/>
        <inf:InverseBoolToVisibilityConverter x:Key="IdleVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部状态条 -->
        <Grid Grid.Row="0" Margin="12,10,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="QueryText" FontWeight="Bold" FontSize="{StaticResource FontSizeTitle}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="重试" Style="{StaticResource BaseButton}"
                        Command="{Binding RetryCommand}"/>
                <Button Content="下一页" Margin="8,0,0,0" Style="{StaticResource BaseButton}"
                        Command="{Binding NextPageCommand}"/>
            </StackPanel>
        </Grid>

        <!-- 左结果列表 / 右详情 -->
        <Grid Grid.Row="1" Margin="12,4,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- 结果列表（表格列） -->
            <ListView Grid.Column="0" Margin="0,0,6,0"
                      ItemsSource="{Binding Results}"
                      SelectedItem="{Binding SelectedResult}"
                      BorderThickness="1">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="标题" Width="140"
                                        DisplayMemberBinding="{Binding Title}"/>
                        <GridViewColumn Header="艺术家" Width="100"
                                        DisplayMemberBinding="{Binding Artist}"/>
                        <GridViewColumn Header="专辑" Width="120"
                                        DisplayMemberBinding="{Binding Album}"/>
                        <GridViewColumn Header="年份" Width="54"
                                        DisplayMemberBinding="{Binding Year}"/>
                        <GridViewColumn Header="风格" Width="66"
                                        DisplayMemberBinding="{Binding Genre}"/>
                        <GridViewColumn Header="来源" Width="88"
                                        DisplayMemberBinding="{Binding SourceName}"/>
                        <GridViewColumn Header="匹配" Width="54"
                                        DisplayMemberBinding="{Binding MatchScore, StringFormat=P0}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- 详情面板 -->
            <Border Grid.Column="1" Margin="6,0,0,0" Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                <Grid>
                    <TextBlock Text="请在左侧选择一条结果查看详情"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                               Visibility="{Binding HasSelectedItem, Converter={StaticResource IdleVis}}"/>

                    <ScrollViewer Visibility="{Binding HasSelectedItem, Converter={StaticResource BusyVis}}"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <!-- 封面缩略图 -->
                            <Border Width="180" Height="180" Margin="0,2,0,8"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource RowHoverBrush}" CornerRadius="3">
                                <Grid>
                                    <TextBlock Text="无封面" Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DetailCover}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Image Source="{Binding DetailCover}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>

                            <!-- 基本信息 -->
                            <TextBlock Text="{Binding SelectedResult.Title}" FontWeight="Bold"
                                       FontSize="{StaticResource FontSizeTitle}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedResult.Artist}" Margin="0,3,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,3,0,0" TextWrapping="Wrap">
                                <Run Text="专辑："/><Run Text="{Binding SelectedResult.Album, Mode=OneWay}"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="年份："/><TextBlock Text="{Binding SelectedResult.Year}"/>
                                <TextBlock Text="  风格：" Margin="12,0,0,0"/>
                                <TextBlock Text="{Binding SelectedResult.Genre}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="来源："/><TextBlock Text="{Binding SelectedResult.SourceName}"/>
                                <TextBlock Text="  匹配：" Margin="12,0,0,0"/>
                                <TextBlock Text="{Binding SelectedResult.MatchScore, StringFormat=P0}"/>
                            </StackPanel>

                            <!-- 扩展字段 -->
                            <ItemsControl ItemsSource="{Binding DetailFields}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,3" BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Key}"
                                                           Margin="0,0,8,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                           TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 歌词片段 -->
                            <TextBlock Text="歌词片段" FontWeight="Bold" Margin="0,10,0,4"
                                       Visibility="{Binding HasSnippet, Converter={StaticResource BusyVis}}"/>
                            <TextBox Style="{StaticResource MultilineTextBox}"
                                     IsReadOnly="True" Height="120"
                                     Text="{Binding DetailSnippet, Mode=OneWay}"
                                     TextWrapping="Wrap"
                                     Visibility="{Binding HasSnippet, Converter={StaticResource BusyVis}}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 详情加载提示 -->
                    <Border Background="#A0FFFFFF"
                            Visibility="{Binding IsDetailLoading, Converter={StaticResource BusyVis}}">
                        <ProgressBar IsIndeterminate="True" Width="160" Height="6"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 首次搜索遮罩 -->
        <Border Grid.Row="1" Margin="12,4,12,8" Background="#80FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BusyVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" Height="6"/>
                <TextBlock Text="{Binding StatusText}" Margin="0,10,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="{StaticResource BottomBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ConfirmCommand}" IsDefault="True"/>
                <Button Content="取消" Margin="8,0,0,0" Style="{StaticResource BaseButton}"
                        Command="{Binding CancelCloseCommand}" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
