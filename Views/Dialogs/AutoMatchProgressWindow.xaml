<Window x:Class="MusicTagRecover.Views.Dialogs.AutoMatchProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在批量匹配标签"
        Width="500" Height="220"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PageBgBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <DockPanel Margin="20">
        <!-- 底部：取消按钮 -->
        <Button x:Name="CancelButton"
                DockPanel.Dock="Bottom"
                Content="取消"
                Style="{StaticResource BaseButton}"
                Width="96"
                HorizontalAlignment="Center"
                Margin="0,16,0,0"
                IsCancel="True"
                Click="CancelButton_Click"/>

        <StackPanel VerticalAlignment="Center">
            <!-- 当前正在处理的文件名（截断时悬浮可见全名） -->
            <TextBlock x:Name="FileNameTextBlock"
                       Text="准备中…"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, ElementName=FileNameTextBlock}"
                       Margin="0,0,0,10"/>
            <!-- 进度文字：正在处理 n / total -->
            <TextBlock x:Name="ProgressTextBlock"
                       Text="正在处理 0 / 0"
                       Margin="0,0,0,8"/>
            <ProgressBar x:Name="ProgressBar"
                         Height="8"
                         Minimum="0"
                         Maximum="1"
                         Value="0"
                         IsIndeterminate="False"/>
        </StackPanel>
    </DockPanel>
</Window>
