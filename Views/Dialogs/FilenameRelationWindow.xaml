<Window x:Class="MusicTagRecover.Views.Dialogs.FilenameRelationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件名与标签联动"
        Width="600" Height="620"
        MinWidth="520" MinHeight="540"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PageBgBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Window.Resources>
        <!-- 布尔值 → 可见性（正则面板） -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- 锁定模式（forcedMode 非空）下隐藏 Tab 头，只显示被锁定的页面 -->
        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- 底部：预览 + 按钮 -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="实时预览" Margin="0,0,0,12">
                <TextBlock Text="{Binding PreviewText}"
                           TextWrapping="Wrap"
                           MinHeight="64"
                           Margin="4,2"/>
            </GroupBox>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Click="OkButton_Click"/>
                <Button Content="取消"
                        Style="{StaticResource BaseButton}"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>

        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <!-- ========== 第 1 页：文件名 → 标签 ========== -->
            <TabItem Header="文件名 → 标签">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,8,0">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="根据文件名按模式提取信息并写入标签。模式中的每个占位符对应文件名中的一段内容，文字与分隔符必须与文件名一致。"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Text="占位符：@0 文件名　@1 标题　@2 艺术家　@3 专辑　@4 碟号　@5 音轨号　@6 年份　@7 注释　@8 专辑艺术家"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="模式：" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding ChangeTagsPattern, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <CheckBox Content="使用正则表达式解析文件名"
                                  Margin="0,2,0,8"
                                  IsChecked="{Binding UseRegex}"
                                  IsEnabled="{Binding CanUseRegex}"/>

                        <!-- 正则设置面板 -->
                        <StackPanel Visibility="{Binding UseRegex, Converter={StaticResource BoolToVisibility}}"
                                    Margin="16,0,0,0">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="正则：" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding RegexPatternText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Text="在正则中使用捕获组 ( )，并将捕获组 1 - 4 映射到标签字段（至少映射一个组）："/>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="捕获组 1" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <ComboBox Grid.Column="1" Margin="0,0,0,8"
                                          ItemsSource="{Binding GroupTargets}"
                                          DisplayMemberPath="Text"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Group1Target}"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="捕获组 2" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <ComboBox Grid.Column="1" Margin="0,0,0,8"
                                          ItemsSource="{Binding GroupTargets}"
                                          DisplayMemberPath="Text"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Group2Target}"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="捕获组 3" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <ComboBox Grid.Column="1" Margin="0,0,0,8"
                                          ItemsSource="{Binding GroupTargets}"
                                          DisplayMemberPath="Text"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Group3Target}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="捕获组 4" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding GroupTargets}"
                                          DisplayMemberPath="Text"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Group4Target}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== 第 2 页：标签 → 文件名 ========== -->
            <TabItem Header="标签 → 文件名">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,8,0">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="根据标签内容按模式生成新文件名并批量重命名。不能使用 @0（文件名）；@4 碟号与 @5 音轨号连用时需写作 @4@5。"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Text="占位符：@1 标题　@2 艺术家　@3 专辑　@4 碟号　@5 音轨号　@6 年份　@7 注释　@8 专辑艺术家"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="模式：" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding RenameFilesPattern, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <CheckBox Content="同时重命名关联文件（.lrc 歌词 / 封面图片）"
                                  Margin="0,2,0,0"
                                  IsChecked="{Binding RenameRelatedFiles}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
