<Window x:Class="MusicTagRecover.Views.Dialogs.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入" SizeToContent="Height" Width="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBox x:Name="InputBox"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Click="OnOk" Margin="0,0,8,0"/>
            <Button Content="取消" Style="{StaticResource BaseButton}" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
