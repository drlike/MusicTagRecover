<Window x:Class="MusicTagRecover.Views.Dialogs.LyricsSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inf="clr-namespace:MusicTagRecover.Infrastructure"
        Title="搜索歌词"
        Width="860" Height="580"
        MinWidth="680" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PageBgBrush}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <inf:BoolToVisibilityConverter x:Key="BusyVis"/>
        <inf:InverseBoolToVisibilityConverter x:Key="IdleVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部状态条 -->
        <Grid Grid.Row="0" Margin="12,10,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="QueryText" FontWeight="Bold" FontSize="{StaticResource FontSizeTitle}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="重试" Style="{StaticResource BaseButton}"
                        Command="{Binding RetryCommand}"/>
                <Button Content="下一页" Margin="8,0,0,0" Style="{StaticResource BaseButton}"
                        Command="{Binding NextPageCommand}"/>
            </StackPanel>
        </Grid>

        <!-- 左结果列表 / 右歌词详情 -->
        <Grid Grid.Row="1" Margin="12,4,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" Margin="0,0,6,0"
                     ItemsSource="{Binding Results}"
                     SelectedItem="{Binding SelectedItem}"
                     BorderThickness="1">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="6,5" Margin="2">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Artist}"
                                               Margin="8,0,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                               ToolTip="{Binding Title}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding SourceName}" FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="{Binding MatchText}" FontSize="{StaticResource FontSizeSmall}"
                                               Margin="8,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Snippet}" Margin="0,4,0,0"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" MaxHeight="78"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="1" Margin="6,0,0,0" Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                <Grid>
                    <!-- 未选择提示 -->
                    <TextBlock Text="请在左侧选择一条结果查看完整歌词"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasSelectedItem, Converter={StaticResource IdleVis}}"/>

                    <!-- 原文/翻译页签 -->
                    <TabControl Margin="6"
                                Visibility="{Binding HasSelectedItem, Converter={StaticResource BusyVis}}">
                        <TabItem Header="原文歌词">
                            <Grid>
                                <TextBox Style="{StaticResource MultilineTextBox}"
                                         IsReadOnly="True"
                                         Text="{Binding OriginalLyric, Mode=OneWay}"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap"/>
                                <Border Background="#C0FFFFFF" Visibility="{Binding IsDetailLoading, Converter={StaticResource BusyVis}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ProgressBar IsIndeterminate="True" Width="200"/>
                                        <TextBlock Text="正在下载歌词…" Margin="0,8,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="翻译歌词">
                            <TabItem.Style>
                                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTranslation}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TabItem.Style>
                            <Grid>
                                <TextBox Style="{StaticResource MultilineTextBox}"
                                         IsReadOnly="True"
                                         Text="{Binding TranslatedLyric, Mode=OneWay}"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- 首次搜索遮罩 -->
        <Border Grid.Row="1" Margin="12,4,12,8" Background="#80FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BusyVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" Height="6"/>
                <TextBlock Text="{Binding StatusText}" Margin="0,10,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="{StaticResource BottomBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存到标签" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ConfirmCommand}" IsDefault="True"/>
                <Button Content="取消" Margin="8,0,0,0" Style="{StaticResource BaseButton}"
                        Command="{Binding CancelCloseCommand}" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
