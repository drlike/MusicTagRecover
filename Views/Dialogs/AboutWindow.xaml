<Window x:Class="MusicTagRecover.Views.Dialogs.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 MusicTagRecover"
        Width="460" Height="320"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PageBgBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <DockPanel Margin="28,24">
        <!-- 底部：确定按钮 -->
        <Button x:Name="OkButton"
                DockPanel.Dock="Bottom"
                Content="确定"
                Style="{StaticResource PrimaryButton}"
                Width="96"
                HorizontalAlignment="Center"
                IsDefault="True"
                IsCancel="True"
                Click="OkButton_Click"/>

        <!-- 中部：应用信息 -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="MusicTagRecover"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center">
                <Run Text="版本 "/><Run x:Name="VersionRun"/>
            </TextBlock>
            <TextBlock Text="音乐标签批量管理工具"
                       Margin="0,12,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="技术栈：WPF / .NET 10 / TagLibSharp"
                       Margin="0,6,0,0"
                       FontSize="{StaticResource FontSizeSmall}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </DockPanel>
</Window>
