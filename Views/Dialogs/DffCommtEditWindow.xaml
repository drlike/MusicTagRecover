<Window x:Class="MusicTagRecover.Views.Dialogs.DffCommtEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑 COMT 原生注释"
        Width="520" SizeToContent="Height"
        MinWidth="460"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PageBgBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,0,0,10"
                   Text="COMT 是 DSDIFF 容器的原生注释块，可包含多条带时间戳的注释（UTF-8 编码）。修改仅作用于注释本身，DSD 音频数据不受影响。"/>

        <TextBlock Text="时间戳" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <UniformGrid Columns="6" Margin="0,0,0,0">
            <StackPanel Margin="0,0,6,0">
                <TextBlock Text="年" FontSize="12"/>
                <TextBox x:Name="YearBox" MinHeight="30" TextAlignment="Center"/>
            </StackPanel>
            <StackPanel Margin="0,0,6,0">
                <TextBlock Text="月" FontSize="12"/>
                <TextBox x:Name="MonthBox" MinHeight="30" TextAlignment="Center"/>
            </StackPanel>
            <StackPanel Margin="0,0,6,0">
                <TextBlock Text="日" FontSize="12"/>
                <TextBox x:Name="DayBox" MinHeight="30" TextAlignment="Center"/>
            </StackPanel>
            <StackPanel Margin="0,0,6,0">
                <TextBlock Text="时" FontSize="12"/>
                <TextBox x:Name="HourBox" MinHeight="30" TextAlignment="Center"/>
            </StackPanel>
            <StackPanel Margin="0,0,6,0">
                <TextBlock Text="分" FontSize="12"/>
                <TextBox x:Name="MinuteBox" MinHeight="30" TextAlignment="Center"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="秒" FontSize="12"/>
                <TextBox x:Name="SecondBox" MinHeight="30" TextAlignment="Center"/>
            </StackPanel>
        </UniformGrid>
        <Button x:Name="NowButton" Content="使用当前时间" Style="{StaticResource BaseButton}"
                HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,3" Click="OnUseNow"/>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock Text="注释类型" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="TypeBox" MinHeight="30" IsEditable="True" SelectedIndex="0">
                    <ComboBoxItem Content="0 - 通用注释"/>
                    <ComboBoxItem Content="1 - 唱片信息"/>
                    <ComboBoxItem Content="2 - 制作信息"/>
                    <ComboBoxItem Content="3 - 抓轨/来源信息"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock Text="引用编号 (0-65535)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="RefBox" MinHeight="30" Text="0"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="注释内容" FontWeight="SemiBold" Margin="0,10,0,4"/>
        <TextBox x:Name="TextBox" MinHeight="110" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>

        <TextBlock x:Name="ErrorText" Foreground="#C0392B" TextWrapping="Wrap"
                   Margin="0,8,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Click="OnOk" Margin="0,0,8,0"/>
            <Button Content="取消" Style="{StaticResource BaseButton}" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
