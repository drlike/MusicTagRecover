<Window x:Class="MusicTagRecover.Views.Dialogs.DirectoryManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MusicTagRecover.ViewModels.Dialogs"
        Title="管理目录"
        Width="600" Height="560"
        MinWidth="520" MinHeight="380"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PageBgBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <DockPanel Margin="16">
        <!-- 说明 -->
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,0,0,8"
                   Text="勾选一个或多个历史目录后点击「切换工作目录」，将以选中目录（可多选）作为当前工作目录加载；也可以仅删除不需要的历史记录（不会删除磁盘文件）。"/>

        <!-- 底部按钮区 -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="全选" Style="{StaticResource BaseButton}" Margin="0,0,8,0"
                        Click="OnSelectAll"/>
                <Button Content="全不选" Style="{StaticResource BaseButton}"
                        Click="OnSelectNone"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="删除选中记录" Style="{StaticResource DangerButton}" Margin="0,0,8,0"
                        Click="OnDelete"/>
                <Button Content="切换工作目录" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                        IsDefault="True" Click="OnSwitch"/>
                <Button Content="关闭" Style="{StaticResource BaseButton}" IsCancel="True"/>
            </StackPanel>
        </Grid>

        <!-- 目录列表 -->
        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="4">
            <ListBox x:Name="DirsList" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DirectoryEntryItemViewModel}">
                        <Grid Margin="2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,2,8,0"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Path}" TextWrapping="Wrap"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DetailText}" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
