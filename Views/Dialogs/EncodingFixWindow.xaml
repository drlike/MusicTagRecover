<Window x:Class="MusicTagRecover.Views.Dialogs.EncodingFixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修复乱码"
        Width="760" Height="520"
        MinWidth="640" MinHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PageBgBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <DockPanel Margin="16">
        <!-- 顶部：源编码 + 方向（WrapPanel 保证窄窗口下不裁切） -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <WrapPanel ItemHeight="34">
                <TextBlock Text="源编码：" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="190"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding Encodings}"
                          DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedEncodingOption}"/>
                <CheckBox Content="交换方向（反向修复）"
                          Margin="20,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding ReverseDirection}"/>
                <TextBlock Text="默认：源编码字节 → UTF-8"
                          Margin="16,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          FontSize="{StaticResource FontSizeSmall}"/>
            </WrapPanel>
        </Grid>

        <!-- 底部：按钮 -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="应用"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Click="ApplyButton_Click"/>
                <Button Content="取消"
                        Style="{StaticResource BaseButton}"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>

        <Grid>
            <!-- 单字段：左原文 / 右预览 -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBatch}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="原文本" Margin="0,0,6,0">
                    <TextBox Style="{StaticResource MultilineTextBox}"
                             IsReadOnly="True"
                             Text="{Binding OriginalText, Mode=OneWay}"
                             VerticalScrollBarVisibility="Auto"/>
                </GroupBox>
                <GroupBox Grid.Column="1" Header="修复预览" Margin="6,0,0,0">
                    <TextBox Style="{StaticResource MultilineTextBox}"
                             IsReadOnly="True"
                             Text="{Binding PreviewText}"
                             VerticalScrollBarVisibility="Auto"/>
                </GroupBox>
            </Grid>

            <!-- 批量：字段行列表 -->
            <DataGrid ItemsSource="{Binding Rows}">
                <DataGrid.Style>
                    <Style TargetType="DataGrid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBatch}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="应用" Width="64">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          IsChecked="{Binding Apply, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="字段" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Key}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="原文" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Original}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="修复预览" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Preview}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
