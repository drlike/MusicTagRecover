<Window x:Class="MusicTagRecover.Views.Dialogs.LyricsEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑歌词"
        Width="700" Height="500"
        MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PageBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,6">
            <WrapPanel>
                <Button Content="格式化时间轴" Style="{StaticResource BaseButton}"
                        Margin="2" Command="{Binding ReformatTimelineCommand}"/>
                <Button Content="删除时间轴" Style="{StaticResource BaseButton}"
                        Margin="2" Command="{Binding RemoveTimelineCommand}"/>
                <Button Content="删除空行" Style="{StaticResource BaseButton}"
                        Margin="2" Command="{Binding RemoveBlankLinesCommand}"/>
                <Button Content="删除头部标签" Style="{StaticResource BaseButton}"
                        Margin="2" Command="{Binding RemoveHeadTagsCommand}"
                        ToolTip="删除 ti:/ar:/al:/by:/offset: 行"/>
                <Button Content="简→繁" Style="{StaticResource BaseButton}"
                        Margin="2" Command="{Binding ConvertToTraditionalCommand}"/>
                <Button Content="繁→简" Style="{StaticResource BaseButton}"
                        Margin="2" Command="{Binding ConvertToSimplifiedCommand}"/>
                <Separator Width="1" Margin="8,4" Background="{StaticResource BorderBrush}"/>
                <Button Content="导入 LRC" Style="{StaticResource BaseButton}"
                        Margin="2" Command="{Binding ImportLrcCommand}"/>
                <Button Content="另存 LRC" Style="{StaticResource BaseButton}"
                        Margin="2" Command="{Binding SaveLrcCommand}"/>
            </WrapPanel>
        </Border>

        <!-- 歌词编辑区 -->
        <Grid Grid.Row="1">
            <TextBox x:Name="LyricsBox" Margin="10,8"
                     Style="{StaticResource MultilineTextBox}"
                     Text="{Binding LyricsText, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas, Microsoft YaHei UI"/>
        </Grid>

        <!-- 底部状态与按钮 -->
        <Border Grid.Row="2" Background="{StaticResource BottomBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="保存到标签" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveToTagsCommand}" IsDefault="True"/>
                    <Button Content="关闭" Margin="8,0,0,0" Style="{StaticResource BaseButton}"
                            Command="{Binding CancelCloseCommand}" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
