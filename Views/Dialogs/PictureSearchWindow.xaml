<Window x:Class="MusicTagRecover.Views.Dialogs.PictureSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inf="clr-namespace:MusicTagRecover.Infrastructure"
        Title="搜索封面"
        Width="760" Height="560"
        MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PageBgBrush}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <inf:BoolToVisibilityConverter x:Key="BusyVis"/>
        <inf:InverseBoolToVisibilityConverter x:Key="IdleVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部状态条 -->
        <Grid Grid.Row="0" Margin="12,10,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="QueryText" FontWeight="Bold" FontSize="{StaticResource FontSizeTitle}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="重试" Style="{StaticResource BaseButton}"
                        Command="{Binding RetryCommand}"/>
                <Button Content="下一页" Margin="8,0,0,0" Style="{StaticResource BaseButton}"
                        Command="{Binding NextPageCommand}"/>
            </StackPanel>
        </Grid>

        <!-- 缩略图网格 -->
        <ListBox Grid.Row="1" Margin="12,4,12,8"
                 ItemsSource="{Binding Results}"
                 SelectedItem="{Binding SelectedItem}"
                 MouseDoubleClick="ListBox_MouseDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 BorderThickness="1">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel ItemWidth="184" ItemHeight="258"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="4" Padding="8" Background="{StaticResource CardBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="150"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource RowHoverBrush}"
                                    CornerRadius="3">
                                <TextBlock Text="加载中…" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <Image Grid.Row="0" Source="{Binding Thumbnail}" Stretch="Uniform"
                                   Margin="2" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <!-- 标题：最多两行，超出省略 -->
                            <TextBlock Grid.Row="1" Text="{Binding Title}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       MaxHeight="36" FontWeight="Bold"
                                       ToolTip="{Binding Title}"/>
                            <!-- 艺术家（填充省略） + 来源（靠右） -->
                            <DockPanel Grid.Row="2" Margin="0,3,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SourceName}"
                                           Foreground="{StaticResource AccentBrush}"
                                           Margin="8,0,0,0"
                                           TextTrimming="CharacterEllipsis" MaxWidth="72"/>
                                <TextBlock Text="{Binding Artist}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Grid.Row="3" Text="{Binding MatchText}"
                                       Margin="0,2,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 加载遮罩 -->
        <Border Grid.Row="1" Margin="12,4,12,8" Background="#80FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BusyVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" Height="6"/>
                <TextBlock Text="{Binding StatusText}" Margin="0,10,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="{StaticResource BottomBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="提示：双击结果可直接下载并使用该封面"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="下载此封面" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ConfirmCommand}" IsDefault="True"/>
                    <Button Content="取消" Margin="8,0,0,0" Style="{StaticResource BaseButton}"
                            Command="{Binding CancelCloseCommand}" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
