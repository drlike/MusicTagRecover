<Window x:Class="MusicTagRecover.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:MusicTagRecover.Infrastructure"
        xmlns:views="clr-namespace:MusicTagRecover.Views"
        Title="MusicTagRecover" Width="1040" Height="720"
        MinWidth="960" MinHeight="600"
        Background="{StaticResource PageBgBrush}"
        AllowDrop="True"
        PreviewKeyDown="OnPreviewKeyDown"
        Drop="OnWindowDrop" DragOver="OnWindowDragOver">

    <Window.Resources>
        <infra:BoolToVisibilityConverter x:Key="BusyVisibility"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <!-- 选中项显示区域：靠左居中 -->
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <!-- 下拉列表项：靠左居中 -->
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="5,0"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
     <DockPanel>
        <!-- ===================== 主菜单 ===================== -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="更改工作目录…  Ctrl+D" Click="OnChangeDirectory"/>
                <MenuItem Header="添加目录…" Click="OnAddDirectory"/>
                <MenuItem Header="管理目录…" Click="OnManageDirectories"/>
                <Separator/>
                <MenuItem Header="预览播放选中文件  Ctrl+P" Click="OnPreviewPlay"/>
                <Separator/>
                <MenuItem Header="刷新  F5" Click="OnRefresh"/>
                <Separator/>
                <MenuItem Header="退出" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem Header="保存标签  Ctrl+S" Click="OnSave"/>
                <MenuItem Header="清除标签  Ctrl+R" Click="OnClearTags"/>
                <MenuItem Header="从磁盘重读标签  Ctrl+T" Click="OnReadTags"/>
                <Separator/>
                <MenuItem Header="全选  Ctrl+A" Click="OnSelectAll"/>
                <MenuItem Header="取消选择  Ctrl+U" Click="OnSelectNone"/>
                <MenuItem Header="反选  Ctrl+Shift+A" Click="OnInvertSelection"/>
                <Separator/>
                <MenuItem Header="重命名  F2" Click="OnRename"/>
                <MenuItem Header="从列表移除  Delete" Click="OnRemoveRows"/>
                <MenuItem Header="删除文件（回收站） Shift+Delete" Click="OnDeleteFiles"/>
                <Separator/>
                <MenuItem Header="标签历史…" Click="OnTagHistory"/>
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem Header="选择显示列…" Click="OnSelectColumns"/>
                <MenuItem Header="隐藏所选文件所在目录" Click="OnHideDirectories"/>
                <MenuItem Header="管理隐藏目录">
                    <MenuItem x:Name="HiddenDirsMenu" Header="（无）"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="标签源(_S)">
                <MenuItem Header="图片源">
                    <MenuItem Header="网易云音乐" Click="OnPictureNetease"/>
                    <MenuItem Header="QQ音乐" Click="OnPictureQq"/>
                    <MenuItem Header="iTunes" Click="OnPictureItunes"/>
                    <MenuItem Header="酷我音乐" Click="OnPictureKuwo"/>
                    <MenuItem Header="Last.fm" Click="OnPictureLastfm"/>
                    <MenuItem Header="MusicBrainz" Click="OnPictureMusicbrainz"/>
                    <MenuItem Header="Discogs" Click="OnPictureDiscogs"/>
                </MenuItem>
                <MenuItem Header="歌词源">
                    <MenuItem Header="网易云音乐" Click="OnLyricsNetease"/>
                    <MenuItem Header="QQ音乐" Click="OnLyricsQq"/>
                    <MenuItem Header="酷我音乐" Click="OnLyricsKuwo"/>
                </MenuItem>
                <MenuItem Header="组合标签">
                    <MenuItem Header="网易云音乐" Click="OnTagNetease"/>
                    <MenuItem Header="QQ音乐" Click="OnTagQq"/>
                    <MenuItem Header="iTunes" Click="OnTagItunes"/>
                    <MenuItem Header="酷我音乐" Click="OnTagKuwo"/>
                    <MenuItem Header="Last.fm" Click="OnTagLastfm"/>
                    <MenuItem Header="MusicBrainz" Click="OnTagMusicbrainz"/>
                    <MenuItem Header="Discogs" Click="OnTagDiscogs"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="批量(_B)">
                <MenuItem Header="歌词处理">
                    <MenuItem Header="格式化时间轴" Click="OnLyricsReformat"/>
                    <MenuItem Header="删除时间轴" Click="OnLyricsRemoveTimeline"/>
                    <MenuItem Header="删除空行" Click="OnLyricsRemoveBlank"/>
                    <MenuItem Header="删除头部标签(ti/ar/al/by/offset)" Click="OnLyricsRemoveHead"/>
                    <Separator/>
                    <MenuItem Header="另存为 LRC…" Click="OnSaveLrc"/>
                    <MenuItem Header="导入 LRC…" Click="OnImportLrc"/>
                    <Separator/>
                    <MenuItem Header="编辑歌词…" Click="OnEditLyrics"/>
                </MenuItem>
                <MenuItem Header="提取封面…" Click="OnExtractCovers"/>
                <MenuItem Header="简繁转换">
                    <MenuItem Header="标签：简体 → 繁体" Click="OnTagsS2T"/>
                    <MenuItem Header="标签：繁体 → 简体" Click="OnTagsT2S"/>
                    <MenuItem Header="文件名：简体 → 繁体" Click="OnFileS2T"/>
                    <MenuItem Header="文件名：繁体 → 简体" Click="OnFileT2S"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="自动匹配标签…" Click="OnAutoMatch"/>
                <MenuItem Header="文件名 ↔ 标签…" Click="OnFilenameRelation"/>
                <Separator/>
                <MenuItem Header="DFF 原生标签（DIIN/COMT）…" Click="OnContextDffNativeTags"/>
            </MenuItem>
            <MenuItem Header="工具(_T)">
                <MenuItem Header="文件比对…" Click="OnOpenCompare"/>
                <MenuItem Header="比对删除历史…" Click="OnOpenDeleteHistory"/>
                <Separator/>
                <MenuItem Header="预览播放选中文件  Ctrl+P" Click="OnPreviewPlay"/>
                <Separator/>
                <MenuItem Header="设置…" Click="OnOpenSettings"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于 MusicTag" Click="OnAbout"/>
            </MenuItem>
        </Menu>

        <!-- ===================== 工具栏 ===================== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <!-- WrapPanel：窗口变窄时按钮自动换行，永远不会被裁切 -->
            <WrapPanel>
                <Button Style="{StaticResource ToolButton}" Content="工作目录" Click="OnChangeDirectory"/>
                <Button Style="{StaticResource ToolButton}" Content="添加目录" Click="OnAddDirectory"/>
                <Button Style="{StaticResource ToolButton}" Content="管理目录" Click="OnManageDirectories"/>
                <Separator Margin="4,3"/>
                <Button Style="{StaticResource ToolButton}" Content="▶ 预览" Click="OnPreviewPlay"/>
                <Separator Margin="4,3"/>
                <Button Style="{StaticResource ToolButton}" Content="保存" Click="OnSave"/>
                <Button Style="{StaticResource ToolButton}" Content="清除" Click="OnClearTags"/>
                <Button Style="{StaticResource ToolButton}" Content="重读" Click="OnReadTags"/>
                <Separator Margin="4,3"/>
                <Button Style="{StaticResource ToolButton}" Content="自动匹配" Click="OnAutoMatch"/>
                <Button Style="{StaticResource ToolButton}" Content="文件名关系" Click="OnFilenameRelation"/>
                <Separator Margin="4,3"/>
                <Button Style="{StaticResource ToolButton}" Content="文件比对" Click="OnOpenCompare"/>
                <Button Style="{StaticResource ToolButton}" Content="设置" Click="OnOpenSettings"/>
            </WrapPanel>
        </Border>

        <!-- ===================== 右侧标签面板（在填充列表前 Dock Right） ===================== -->
        <views:TagEditControl DockPanel.Dock="Right" DataContext="{Binding TagEdit}"
                              SaveClicked="OnSave"/>

        <!-- ===================== 底部过滤 + 状态栏 ===================== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BottomBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <!-- 分列布局：左侧筛选、右侧进度，互不重叠 -->
                <Grid Margin="10,7,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="筛选：" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox MinWidth="180" Width="180" Margin="6,0,0,0"
                                 HorizontalAlignment="Left"
                                 Text="{Binding FilterKeyword, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox MinWidth="110" Width="110" Margin="8,0,0,0"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding FilterTypes}"
                                  SelectedItem="{Binding SelectedFilterType}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar Width="140" Height="8" VerticalAlignment="Center"
                                     IsIndeterminate="{Binding IsIndeterminate}"
                                     Minimum="0" Maximum="1" Value="{Binding Progress}"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BusyVisibility}}"/>
                        <TextBlock Text="处理中…" Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource AccentBrush}"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BusyVisibility}}"/>
                    </StackPanel>
                </Grid>
                <!-- 状态行：右侧信息先停靠，左侧状态文本自动获得剩余宽度并省略 -->
                <DockPanel Margin="10,0,10,7">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding InfoText}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Margin="12,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="{StaticResource FontSizeSmall}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StatusText}"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ===================== 内嵌播放栏（默认隐藏，预览播放时在主窗口内展开） ===================== -->
        <views:PlayerBar x:Name="Player" DockPanel.Dock="Bottom" Visibility="Collapsed"
                         FullscreenRequested="OnPlayerFullscreen"
                         CloseRequested="OnPlayerClose"/>

        <!-- ===================== 文件列表 ===================== -->
        <!-- 虚拟化：仅实例化可视区行容器并回收复用，支撑数万行不占 UI 内存 -->
        <DataGrid x:Name="FilesGrid"
                  ItemsSource="{Binding Rows}"
                  SelectionChanged="OnSelectionChanged" CanUserSortColumns="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  PreviewMouseRightButtonDown="OnListRightButtonDown"
                  MouseDoubleClick="OnListMouseDoubleClick">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="保存标签" Click="OnSave"/>
                    <MenuItem Header="清除标签" Click="OnClearTags"/>
                    <MenuItem Header="重读标签" Click="OnReadTags"/>
                    <MenuItem Header="编码修正…" Click="OnContextEncodingFix"/>
                    <Separator/>
                    <MenuItem Header="DFF 原生标签（DIIN/COMT）…" Click="OnContextDffNativeTags"/>
                    <Separator/>
                    <MenuItem Header="重命名（F2）" Click="OnContextRename"/>
                    <MenuItem Header="删除文件（Shift+Del）" Click="OnDeleteFiles"/>
                    <Separator/>
                    <MenuItem Header="打开文件目录" Click="OnOpenFileLocation"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
     </DockPanel>

     <!-- ===================== 窗口内全屏覆盖层（不弹窗；播放器重parent到此） ===================== -->
     <Grid x:Name="FullScreenLayer" Background="Black" Visibility="Collapsed"/>
    </Grid>
</Window>
