<UserControl x:Class="MusicTagRecover.Views.PlayerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CardBgBrush}"
             FontFamily="{StaticResource AppFontFamily}">
    <Border x:Name="RootBorder" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
        <Grid x:Name="RootGrid" Margin="10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="VideoColumn" Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 视频画面区（纯音频时显示占位图标；全屏时该区域被拉伸覆盖整个控件） -->
            <Grid x:Name="MediaBox" Grid.Column="0" Width="300" Height="170"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  Background="Black">
                <Image x:Name="VideoImage" Stretch="Uniform"/>
                <!-- 纯音频占位 -->
                <Border x:Name="AudioPlaceholder" Visibility="Collapsed" Background="#1A1A1A">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🎵" FontSize="44" HorizontalAlignment="Center"
                                   Foreground="#9AA0A6"/>
                        <TextBlock Text="音频文件" Margin="0,8,0,0" Foreground="#9AA0A6"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- 加载中 -->
                <Border x:Name="LoadingOverlay" Background="#99000000" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="加载中…" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- 错误提示 -->
                <Border x:Name="ErrorOverlay" Background="#AA220000" Visibility="Collapsed">
                    <StackPanel Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⚠ 无法播放" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" FontSize="15"/>
                        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" MaxWidth="320"
                                   Foreground="#F1C0C0" Margin="0,8,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 标题 + 控制区（全屏时变为底部悬浮半透明条） -->
            <Grid x:Name="InfoPanel" Grid.Column="1" Margin="12,2,2,2" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题行 -->
                <DockPanel Grid.Row="0">
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="✕" Width="28"
                            Style="{StaticResource ToolButton}" Margin="6,0,0,0"
                            ToolTip="关闭播放器" Click="OnCloseClick"/>
                    <Button x:Name="FullscreenButton" DockPanel.Dock="Right" Content="⛶" Width="34"
                            Style="{StaticResource ToolButton}" Margin="4,0,0,0"
                            ToolTip="全屏切换（Esc 退出）" Click="OnFullscreenClick"/>
                    <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, ElementName=TitleText}"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <!-- 编码信息 / 状态 -->
                <TextBlock x:Name="CodecText" Grid.Row="1" FontSize="11" Margin="2,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Top"/>

                <!-- 进度行 -->
                <Grid Grid.Row="2" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText" Grid.Column="0" Text="00:00"
                               VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas"
                               FontSize="12"/>
                    <Slider x:Name="PositionSlider" Grid.Column="1"
                            Minimum="0" Maximum="1" Value="0"
                            IsMoveToPointEnabled="True"
                            Thumb.DragStarted="OnSeekStarted"
                            Thumb.DragCompleted="OnSeekCompleted"
                            PreviewMouseUp="OnSeekMouseUp"/>
                    <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="00:00"
                               VerticalAlignment="Center" Margin="8,0,0,0" FontFamily="Consolas"
                               FontSize="12"/>
                </Grid>

                <!-- 按钮行：三列 Grid，窄窗口下列各自收缩不重叠 -->
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PrevButton" Content="⏮" Width="40" Margin="0,0,3,0"
                                Padding="0" Style="{StaticResource BaseButton}" Click="OnPrevClick" ToolTip="上一个"/>
                        <Button x:Name="PlayPauseButton" Content="▶" Width="54" Margin="3,0"
                                Padding="0" Style="{StaticResource PrimaryButton}" Click="OnPlayPauseClick"
                                ToolTip="播放/暂停（空格）"/>
                        <Button x:Name="StopButton" Content="⏹" Width="40" Margin="3,0"
                                Padding="0" Style="{StaticResource BaseButton}" Click="OnStopClick" ToolTip="停止"/>
                        <Button x:Name="NextButton" Content="⏭" Width="40" Margin="3,0,0,0"
                                Padding="0" Style="{StaticResource BaseButton}" Click="OnNextClick" ToolTip="下一个"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MuteButton" Content="🔊" Width="30" Margin="0" Padding="0"
                                Style="{StaticResource ToolButton}"
                                Click="OnMuteClick" ToolTip="静音"/>
                        <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="100" Value="50"
                                VerticalAlignment="Center" Margin="6,0,0,0"
                                ValueChanged="OnVolumeChanged" IsMoveToPointEnabled="True"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
